<resources>
    <style name="Theme.CCUI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ccui_primary</item>
        <item name="colorOnPrimary">@color/ccui_on_primary</item>
        <item name="colorSecondaryContainer">@color/ccui_secondary_container</item>
        <item name="colorSurface">@color/ccui_surface</item>
        <item name="colorOnSurface">@color/ccui_on_surface</item>
        <item name="materialButtonStyle">@style/Widget.CCUI.Button</item>
        <item name="materialCardViewStyle">@style/Widget.CCUI.Card</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/ccui_light_bars</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Widget.CCUI.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="Widget.CCUI.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
